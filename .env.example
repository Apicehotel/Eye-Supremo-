# Ambiente locale Eye Supremo (PC)

# IA light (~16 GB RAM)
RANDFATTURE_OLLAMA_URL=http://127.0.0.1:11434
RANDFATTURE_CHAT_MODEL=qwen3:4b
RANDFATTURE_EMBEDDING_MODEL=nomic-embed-text

# Prefisso RANDFATTURE_* mantenuto solo per compatibilità con .env esistenti.
# Nome prodotto e UI: Eye Supremo. Non usare questo prefisso in testi mostrati agli utenti.
# Supabase MultiHotel = blob Storage + catalogo eye_central_*
# Path: eye-invoices/invoices/{xml|pdf|doc}/{hh}/{sha256}{ext}
RANDFATTURE_SUPABASE_URL=https://ooqlfldcrnkudhgjnied.supabase.co
RANDFATTURE_SUPABASE_SERVICE_KEY=
RANDFATTURE_SUPABASE_ANON_KEY=
RANDFATTURE_SUPABASE_BUCKET=eye-invoices
RANDFATTURE_SUPABASE_STORAGE_ROOT=invoices
# Opzionale: connection string Postgres per applicare la migration da PowerShell
# (Dashboard → Project Settings → Database → URI). Se assente, lo script copia lo SQL negli appunti.
# RANDFATTURE_SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.ooqlfldcrnkudhgjnied.supabase.co:5432/postgres
# Catalogo centrale: Edge gateway (preferito) + PIN MultiHotel
RANDFATTURE_SUPABASE_CENTRAL_GATEWAY=https://ooqlfldcrnkudhgjnied.supabase.co/functions/v1/eye-central-gateway
RANDFATTURE_SUPABASE_CENTRAL_GATEWAY_ACTION=invoice_page
RANDFATTURE_SUPABASE_CENTRAL_USERNAME=sviluppatore
RANDFATTURE_SUPABASE_CENTRAL_PIN=
# Recensioni: stessa URL/PIN + ANON_KEY (o SERVICE_KEY) → RPC eye_central_review_page
# Area UI «Recensioni» legge public.eye_central_reviews (vedi docs/SUPABASE_REVIEWS.md)
