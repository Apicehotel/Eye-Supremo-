# Eye Supremo local runtime
EYESUPREMO_OLLAMA_URL=http://127.0.0.1:11434
# Layer mirror: veloce di default sui PC ufficio; qualità solo in escalation
EYESUPREMO_CHAT_MODEL_FAST=llama3.2:3b
EYESUPREMO_CHAT_MODEL=qwen3:8b
EYESUPREMO_EMBEDDING_MODEL=qwen3-embedding:0.6b
EYESUPREMO_AI_LAYER_POLICY=fast_first
# Al primo avvio scarica fatture+recensioni in cache SQLite (offline)
EYESUPREMO_CACHE_BOOTSTRAP_ON_START=true
EYESUPREMO_MAX_UPLOAD_MB=30

# Optional authenticated Supabase bridge
EYESUPREMO_SYNC_ENABLED=false
EYESUPREMO_SUPABASE_URL=
EYESUPREMO_SUPABASE_PUBLISHABLE_KEY=
# Runtime session token; do not commit real tokens.
EYESUPREMO_SUPABASE_ACCESS_TOKEN=
