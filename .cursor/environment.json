{
  "name": "RandFatture",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && PYTHONPATH=. ../.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
    },
    {
      "name": "frontend",
      "command": "npm --prefix frontend run dev -- --host 127.0.0.1 --port 5173"
    }
  ],
  "ports": [8000, 5173]
}
